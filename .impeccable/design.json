      "css": ".ds-budget{width:320px;display:flex;flex-direction:column;gap:8px;font:400 14px 'PingFang TC','Noto Sans TC',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-variant-numeric:tabular-nums;color:var(--c-ink,#1C1F23)}.ds-budget-top{display:flex;justify-content:space-between;align-items:baseline}.ds-budget-top b{font-size:16px;font-weight:600}.ds-bar{position:relative;height:8px;border-radius:999px;background:var(--c-track,#E8EBEE)}.ds-bar i{position:absolute;top:0;bottom:0}.ds-bar-c{left:0;background:var(--c-muted,#5E646B);border-radius:999px 0 0 999px}.ds-bar-u{background:var(--c-muted,#5E646B);opacity:.35}.ds-bar-p{top:-2px!important;bottom:-2px!important;width:2px;margin-left:-1px;background:var(--c-ink,#1C1F23);opacity:.6}.ds-budget-meta{font-size:12px;color:var(--c-muted,#5E646B)}"
